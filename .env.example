# ==========================================
# CONFIGURACION GENERAL
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# BASE DE DATOS POSTGRESQL
# ==========================================
DATABASE_URL=postgresql://cursos_app:CAMBIAR_PASSWORD@localhost:5432/cursos_db

# ==========================================
# AUTENTICACION JWT
# ==========================================
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRES_IN=24h

# ==========================================
# CONFIGURACION DE LA APLICACION
# ==========================================
APP_BASE_URL=http://localhost:3000

# ==========================================
# SERVICIO DE CORREO SMTP
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=correo@example.com
SMTP_PASS=REEMPLAZAR_POR_PASSWORD_DE_APLICACION
EMAIL_FROM=correo@example.com

# ==========================================
# CREACION DEL ADMINISTRADOR
# ==========================================
ADMIN_NAME=Admin Sistema
ADMIN_EMAIL=admin@cursoscloud.com
ADMIN_PASSWORD=REEMPLAZAR_POR_PASSWORD_DE_12_CARACTERES_MINIMO

# ==========================================
# SUPABASE GRAPHQL
# ==========================================
SUPABASE_GRAPHQL_URL=REEMPLAZAR_POR_ENDPOINT_GRAPHQL
SUPABASE_API_KEY=REEMPLAZAR_POR_CLAVE_PUBLICA
