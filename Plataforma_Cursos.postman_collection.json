{
  "info": {
    "name": "Plataforma de Cursos",
    "description": "Pruebas de los seis endpoints CUR-01 a CUR-06. Configura baseUrl y token en variables de colección antes de ejecutar las solicitudes protegidas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Cursos — lecturas",
      "item": [
        {
          "name": "CUR-01 Listar cursos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "description": "Lista los cursos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Respuesta contiene data', () => pm.expect(pm.response.json()).to.have.property('data'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CUR-02 Consultar curso existente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "1"
              ]
            },
            "description": "Ajustar el ID si los datos de prueba usan otro."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 o 404 según los datos', () => pm.expect([200,404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "CUR-02 Curso inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "999999"
              ]
            },
            "description": "Prueba de recurso inexistente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "CUR-03 Buscar texto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "PostgreSQL"
                }
              ]
            },
            "description": "Buscar por título o descripción."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "CUR-03 Filtrar por categoría y precio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "search"
              ],
              "query": [
                {
                  "key": "category_id",
                  "value": "2"
                },
                {
                  "key": "min_price",
                  "value": "10"
                },
                {
                  "key": "max_price",
                  "value": "60"
                }
              ]
            },
            "description": "Filtros combinados."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "CUR-03 Rango de precio inválido",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "search"
              ],
              "query": [
                {
                  "key": "min_price",
                  "value": "80"
                },
                {
                  "key": "max_price",
                  "value": "10"
                }
              ]
            },
            "description": "Debe rechazar precio mínimo mayor que máximo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cursos — escrituras",
      "item": [
        {
          "name": "CUR-04 Crear curso sin token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "description": "Se espera 403; sirve para comprobar la protección.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Curso de prueba sin token\",\n  \"description\": \"Caso negativo\",\n  \"price\": 10,\n  \"category_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "CUR-04 Crear curso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "description": "Requiere token válido y category_id existente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Curso de prueba\",\n  \"description\": \"Registro temporal para probar el endpoint\",\n  \"price\": 25.5,\n  \"category_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "CUR-04 Precio negativo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "description": "Debe rechazar precio negativo. Requiere token válido.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Curso inválido\",\n  \"description\": \"Prueba de validación\",\n  \"price\": -5,\n  \"category_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "CUR-05 Actualizar curso",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courses/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "1"
              ]
            },
            "description": "Requiere token válido y un curso existente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Curso actualizado por prueba\",\n  \"price\": 29.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 o 404 según el ID', () => pm.expect([200,404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "CUR-06 Eliminar curso",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courses/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "999999"
              ]
            },
            "description": "Prueba de ID inexistente; debe responder 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "CUR-06 Eliminar curso sin token",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "1"
              ]
            },
            "description": "Debe responder 403."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": "PEGA_AQUI_UN_TOKEN_JWT_VALIDO"
    }
  ]
}